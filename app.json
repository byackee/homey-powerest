          "type": "number",
          "value": 153,
          "min": 100,
          "max": 600,
          "label": {
            "en": "Coldest colour temperature (mired)",
            "fr": "Température de couleur la plus froide (mired)",
            "nl": "Koudste kleurtemperatuur (mired)"

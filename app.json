          "nl": "Niet-gemeten aandeel stijgt boven [[percent]] %"
        },
        "hint": {
          "en": "What the main meter sees and no device explains. A jump usually means an appliance nothing is estimating.",
          "fr": "Ce que le compteur voit et qu'aucun appareil n'explique. Un bond signale en général un appareil que rien n'estime.",
          "nl": "Wat de hoofdmeter ziet en geen apparaat verklaart."
        },
        "args": [
          {
            "name": "percent",
            "type": "number",
            "min": 0,
            "max": 100,
            "step": 1,
            "placeholder": {

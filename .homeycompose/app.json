{
  "id": "com.dataweavelabs.powerestimate",
  "version": "1.0.5",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "brandColor": "#F59F00",
  "name": {
    "en": "Power Estimator",
    "fr": "Power Estimator",
    "nl": "Power Estimator"
  },
  "description": {
    "en": "Power that follows dimming and colour, from measured device profiles — where one fixed figure cannot be right",
    "fr": "Une puissance qui suit la gradation et la couleur, à partir de profils mesurés — là où une valeur fixe ne peut pas être juste",
    "nl": "Vermogen dat het dimniveau en de kleur volgt, uit gemeten profielen — waar één vaste waarde niet kan kloppen"
  },
  "category": [
    "tools",
    "energy"
  ],
  "permissions": [
    "homey:manager:api"
  ],
  "tags": {
    "en": [
      "power",
      "energy",
      "watt",
      "kwh",
      "estimate",
      "hue",
      "philips",
      "signify",
      "ikea",
      "tuya",
      "innr",
      "powercalc",
      "virtual meter",
      "consumption"
    ],
    "fr": [
      "puissance",
      "énergie",
      "watt",
      "kwh",
      "estimation",
      "hue",
      "philips",
      "signify",
      "ikea",
      "tuya",
      "innr",
      "powercalc",
      "compteur virtuel",
      "consommation"
    ],
    "nl": [
      "vermogen",
      "energie",
      "watt",
      "kwh",
      "schatting",
      "hue",
      "philips",
      "signify",
      "ikea",
      "tuya",
      "innr",
      "powercalc",
      "virtuele meter",
      "verbruik"
    ]
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "DataWeave Labs"
  },
  "api": {
    "getStatus": {
      "method": "GET",
      "path": "/status",
      "role": "owner"
    },
    "getCandidates": {
      "method": "GET",
      "path": "/candidates",
      "role": "owner"
    },
    "refreshLibrary": {
      "method": "POST",
      "path": "/library/refresh",
      "role": "owner"
    },
    "getTrace": {
      "method": "GET",
      "path": "/trace",
      "role": "owner"
    },
    "getUsages": {
      "method": "GET",
      "path": "/usages",
      "role": "owner"
    },
    "setUsage": {
      "method": "PUT",
      "path": "/usages",
      "role": "owner"
    }
  },
  "source": "https://github.com/byackee/homey-powerest",
  "bugs": {
    "url": "https://github.com/byackee/homey-powerest/issues"
  },
